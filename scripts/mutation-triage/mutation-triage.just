# Mutation-triage survivor loop — drop-in recipes for any Rust workspace.
#
# Install:
#   cp -r <this repo>/scripts       <your repo>/scripts/mutation-triage
#   cp    <this repo>/mutation-triage.just <your repo>/scripts/mutation-triage/
#   echo "import 'scripts/mutation-triage/mutation-triage.just'" >> justfile
#   printf '/mutants.out\n/mutants.out.old\n' >> .gitignore
#   just mutants-init && git add mutants-equivalence.toml
#
# The last two are not optional. `mutants-gates` refuses an absent ledger, so
# `verify` cannot pass until `mutants-init` has created the file; and the sweep
# artefacts are regenerated by every run and belong to nobody.
#
# To override any mt_* variable below, your justfile needs BOTH of these — the
# setting, and the override placed AFTER the import (the later definition wins):
#
#   set allow-duplicate-variables := true
#   import 'scripts/mutation-triage/mutation-triage.just'
#   mt_green_cmd := "cargo nextest run --workspace --all-features --run-ignored all"
#
# Without the setting, `just` refuses the redefinition outright with
# "Variable `mt_green_cmd` has multiple definitions" — it does not silently
# prefer yours.
#
# Requires `mutants-triage` and `cargo-mutants` on PATH:
#   cargo install --git https://github.com/igouss/mutation-triage mutants-triage-cli
#   cargo install cargo-mutants
#
# Read docs/MUTATION_TRIAGE.md once before using any of these. The two rules
# that matter most:
#
#   NEVER BULLDOZE. Writing a contorted test to kill an equivalent mutant
#   asserts implementation, not spec. Record it, do not commit it.
#
#   KILL VERIFICATION. A test-gap issue closes ONLY when re-running exactly
#   that mutant reports KILLED. "a test was added" is never evidence.
#   FLAG TRAP 1: -f/--file FILTERS files, it does not SCOPE the run. Without
#   -p it selects NOTHING, and selecting nothing exits successfully having
#   tested nothing -- which reads as "everything killed".
#   FLAG TRAP 2: -F is an alias of --re, a mutant-NAME regex matched against
#   --list names. -F is NOT the file flag.

# REQUIRED, and set here so a consumer cannot forget it: seven recipes below
# pass recipe arguments through to bash as "$@" / "$1", and without this `just`
# does not expose them at all. The failure is loud for `mutants` (the scope
# guard sees no args and refuses the sweep) but it is a refusal that looks like
# a bad invocation rather than a missing setting, which costs an afternoon.
set positional-arguments := true

# How to invoke the tool. The default assumes `cargo install` put it on PATH.
# Override to run it from source — which is how this tool's own repo dogfoods
# itself, and how you test a local change before installing it:
#   mt_bin := "cargo run -q -p mutants-triage-cli --"
mt_bin := "mutants-triage"

# Where the three guard scripts were copied to.
mt_scripts := justfile_directory() / "scripts/mutation-triage"
# Raise on a fast machine; a TIMEOUT verdict is never conclusive.
mt_timeout := "120"
# Sweeps are compile-bound. More jobs contend for target/ and manufacture
# timeouts that read as kills.
mt_jobs := "2"
# Pinned so fresh proptest seeds cannot flip kill/survive run to run — the
# ledger keys against a stable verdict set.
mt_proptest_cases := "64"
# Any other pin your suite needs to give one verdict twice, as space-separated
# NAME=value words. The green stamp and every sweep run under it. A hegel suite
# sets "CI=1": hegel fixes its seed only when it believes it runs in CI, and has
# no switch of its own.
mt_test_env := ""
# Where cargo-mutants builds its scratch trees: the sweeps' TMPDIR. The system
# temp dir is RAM-backed tmpfs on many boxes, where a scratch tree competes with
# the build for memory.
mt_scratch_dir := justfile_directory() / "target/mutants-scratch"

# The sweep. Hours on a real crate: run it serially, off-hours.
[doc("Sweep one crate. Serial, off-hours; hours on a real crate.")]
mutants *args:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{ mt_scripts }}/mutants-scope-guard.sh" -- "$@"
    mkdir -p "{{ mt_scratch_dir }}"
    export PROPTEST_CASES={{ mt_proptest_cases }} {{ mt_test_env }}
    TMPDIR="{{ mt_scratch_dir }}" cargo mutants \
        --test-tool=nextest --timeout={{ mt_timeout }} --jobs={{ mt_jobs }} \
        --all-features --no-shuffle "$@"

# Enumerate WITHOUT building or testing. Sizes the problem in seconds.
[doc("Enumerate mutants without building or testing. Seconds.")]
mutants-list *args:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{ mt_scripts }}/mutants-scope-guard.sh" --allow-workspace -- "$@"
    cargo mutants --list --all-features --no-shuffle "$@"

# Mutate only code changed vs the origin/main merge-base. NOT a gate: on a slow
# box per-mutant verdicts flake via timeouts, so treat survivors as triage
# input, never as a red/green signal in a hook.
[doc("Mutate only code changed vs origin/main. Triage input, never a gate.")]
mutants-diff *args:
    #!/usr/bin/env bash
    set -euo pipefail
    git diff "$(git merge-base origin/main HEAD)" > target/mutants-base.diff
    mkdir -p "{{ mt_scratch_dir }}"
    export PROPTEST_CASES={{ mt_proptest_cases }} {{ mt_test_env }}
    TMPDIR="{{ mt_scratch_dir }}" cargo mutants \
        --test-tool=nextest --timeout={{ mt_timeout }} --jobs={{ mt_jobs }} \
        --all-features --no-shuffle --in-diff target/mutants-base.diff "$@"

# Seconds, not hours: refuse the sibling-test trap before a sweep compiles.
# Without a `.cargo/mutants.toml`, `--test-workspace` defaults false and
# `just mutants -p <crate>` runs ONLY that crate's own tests. A crate whose
# tests live in a sibling would report 100% survivors — a fabricated test-gap
# avalanche. Exits 3 and prints the --test-package remedy instead.
[doc("Refuse a sweep whose tests would never run. Seconds.")]
mutants-preflight crate:
    {{ mt_bin }} preflight -p {{ crate }}

# The AUTHORITATIVE census for one crate: every mutant that exists, whether or
# not the last sweep looked at it. Triage reads this, never
# `mutants.out/mutants.json` — both files are rewritten by EVERY `just mutants`
# run, including the narrowed kill-verification re-run this loop mandates, so
# triaging against them asks "did everything the last run selected get killed?"
# and answers yes.
[doc("The authoritative mutant census for one crate. No build.")]
mutants-census crate:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p target/mutation-triage
    cargo mutants --list --json --all-features --no-shuffle -p {{ crate }} \
        > "target/mutation-triage/census-{{ crate }}.json"
    # The files it walks, so triage can name what it never mutates in them.
    cargo mutants --list-files --json -p {{ crate }} \
        > "target/mutation-triage/files-{{ crate }}.json"
    # Progress goes to stderr. Six recipes below call this one before emitting
    # the tool's own output, so a progress line on stdout lands in front of the
    # JSON that `--format json` promised and nothing can parse the result.
    echo "census: target/mutation-triage/census-{{ crate }}.json" >&2

# The classified report — the ONLY thing an adjudicating agent reads.
# Exit codes: 0 converged · 2 adjudication needed · 3 sweep refused · 1 error.
# Convergence requires EVERY census mutant to have reached a conclusion: a
# timeout is never conclusive and an unevaluated mutant is not a result.
[doc("The classified survivor report. 0 converged / 2 adjudicate / 3 refused.")]
mutants-triage crate *args:
    #!/usr/bin/env bash
    set -euo pipefail
    just mutants-census {{ crate }}
    sha="$(git rev-parse --short HEAD)"
    fingerprint="$("{{ mt_scripts }}/tree-fingerprint.sh")"
    flags=()
    if [ -f "target/mutation-triage/green-$fingerprint" ]; then flags+=(--green-tree); fi
    shift
    {{ mt_bin }} triage -p {{ crate }} \
        --census "target/mutation-triage/census-{{ crate }}.json" \
        --files "target/mutation-triage/files-{{ crate }}.json" \
        --from mutants.out/outcomes.json \
        --tree-sha "$sha" --tree-fingerprint "$fingerprint" "${flags[@]}" "$@"

# Stamp this WORKING TREE green so `--baseline skip` becomes admissible.
# Keyed to a tree fingerprint, NOT to `git rev-parse HEAD`: the sha does not
# move when you edit a file, and editing tests at one commit is this loop's
# entire activity — a sha-keyed stamp would survive every failed fix attempt
# and authorise a skip on a red tree, where every mutant looks killed.
#
# Override `mt_green_cmd` if your full suite is not `cargo nextest run
# --workspace --all-features`. It must be the STRONGER suite: `just mutants`
# pins --all-features, and a weaker run silently drops every target whose
# required-features fall outside default resolution.
#
# It runs under the sweep's own pins, so the stamp certifies the baseline the
# sweep would otherwise have run, not a differently seeded one.
mt_green_cmd := "cargo nextest run --workspace --all-features"

[doc("Stamp this working tree green so --baseline skip becomes admissible.")]
mutants-green:
    #!/usr/bin/env bash
    set -euo pipefail
    export PROPTEST_CASES={{ mt_proptest_cases }} {{ mt_test_env }}
    {{ mt_green_cmd }}
    mkdir -p target/mutation-triage
    fingerprint="$("{{ mt_scripts }}/tree-fingerprint.sh")"
    touch "target/mutation-triage/green-$fingerprint"
    echo "stamped green: working tree $fingerprint (HEAD $(git rev-parse --short HEAD))"

# Create the ledger. Run this ONCE, when wiring the tool into a project, and
# commit the file — `mutants-gates` refuses an absent ledger, so `verify` cannot
# pass until it exists.
#
# Idempotent and never destructive: a ledger that is already there is left
# exactly as it is.
[doc("Create the ledger file. Run once at setup, then commit it.")]
mutants-init:
    {{ mt_bin }} ledger init

# Ledger schema + evidence integrity. No sweep, no build, under a second.
# THIS is the gate to wire into your own `verify` recipe.
#
# (The sibling gate `mutant-schema-neutral` is NOT shipped here on purpose: it
# guards the mutation-triage tool's own neutral core, and a project that merely
# installs the binary has no such core to violate. It lives in the tool's repo.)
[doc("Ledger integrity gate. Wire THIS into your verify recipe.")]
mutants-gates *args:
    {{ mt_bin }} ledger check {{ args }}

# What this tool is and how to drive it, printed by the tool. Neither needs a
# workspace, so both answer on first contact.
[doc("The agent guide: the loop, the exit codes, the rules, the flag traps.")]
mutants-docs:
    {{ mt_bin }} robot-docs

# The contract as data: commands, output formats, and the exit-code dictionary.
[doc("This tool's contract as JSON. Read this before parsing anything else.")]
mutants-capabilities:
    {{ mt_bin }} capabilities --json

# The whole loop for one crate, in order, with the exit codes explained.
#
# Deliberately NOT `set -e`: this loop's informative outcomes are non-zero.
# cargo-mutants exits 2 when mutants survived and 3 when any timed out (timeout
# outranks); mutants-triage exits 2 when adjudication is needed. All are normal,
# and a script that aborted on non-zero would report the healthy case as failure.
#
# Step 3 (the green stamp) is what makes later single-mutant kill re-runs cheap.
# Step 4 is the only slow step. Measured on one laptop: 36 mutants in 83s, 189
# mutants in 12m — roughly 2-4s per mutant once the baseline is built, plus one
# baseline build up front. Budget by mutant count, which `mutants-census` gives
# you in seconds before you commit to anything.
[doc("The whole loop for one crate: preflight, census, green stamp, sweep, triage.")]
mutants-loop crate:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "── 1/5 preflight ── refuse a sweep whose tests never run"
    if ! just mutants-preflight {{ crate }}; then
        echo
        echo "REFUSED before spending any compile time. Fix the test wiring, do not work around it."
        exit 3
    fi
    echo
    echo "── 2/5 census ── every mutant that exists, no build"
    just mutants-census {{ crate }} || exit 1
    echo
    echo "── 3/5 green stamp ── makes --baseline skip admissible later"
    just mutants-green || { echo "suite is RED — a sweep now would call every mutant killed"; exit 1; }
    echo
    echo "── 4/5 sweep ── the slow step; ~2-4s per mutant plus a baseline build"
    just mutants -p {{ crate }}
    sweep=$?
    case "${sweep}" in
      0) echo "sweep exit 0 — every mutant caught" ;;
      2) echo "sweep exit 2 — mutants survived; normal, and the reason to triage" ;;
      3) echo "sweep exit 3 — at least one mutant TIMED OUT (outranks 2). A timeout is"
         echo "               never conclusive: read the mutation before blaming the box." ;;
      *) echo "sweep exit ${sweep}" ;;
    esac
    echo
    echo "── 5/5 triage ── verdicts joined onto the full census"
    just mutants-triage {{ crate }}
    verdict=$?
    echo
    case "${verdict}" in
      0) echo "CONVERGED — no survivors, no timeouts, nothing unevaluated. Anything listed"
         echo "            under NEVER EXAMINED was never mutated: no sweep speaks for it." ;;
      2) echo "ADJUDICATION NEEDED — hand the survivors to an agent:"
         echo "  Workflow({ scriptPath: \".claude/workflows/mutants-adjudicate.js\","
         echo "             args: { repo: \"$(pwd)\", crate: \"{{ crate }}\" } })" ;;
      3) echo "SWEEP REFUSED — the report above says why. Do not work around it." ;;
      64) echo "USAGE ERROR — the triage command line was wrong. Nothing was judged."
          echo "  This is deliberately NOT 2: a typo must never summon an adjudicator." ;;
      *) echo "tool error (${verdict})" ;;
    esac
    exit "${verdict}"

# File one equivalence claim. REFUSES without two well-formed refutations from
# two different agents, neither of them the claimant, and REFUSES a mutant that
# did not actually SURVIVE the run named by --from.
#
# Every argument is passed as real argv ("$1"), never spliced as text: a
# justification is 60-400 characters of English, and English at that length
# routinely contains an apostrophe.
# Usage: just mutants-admit <crate> '<key>' '<justification>' <argument> <refutations.toml>
[doc("File one equivalence claim. Refuses without two independent refutations.")]
mutants-admit crate key justification argument refutations:
    #!/usr/bin/env bash
    set -euo pipefail
    just mutants-census "$1"
    {{ mt_bin }} ledger admit \
        --key "$2" --justification "$3" \
        --argument "$4" --refutation "$5" \
        --census "target/mutation-triage/census-$1.json" \
        --from mutants.out/outcomes.json \
        --adjudicated-at "$(git rev-parse --short HEAD)" \
        --claimed-by "${AGENT_MAIL_AGENT:-$USER}"

# Re-affirm a stale claim. REFUSES without a FRESH refutation at a NEW tree
# sha — a digest bump is not evidence.
[doc("Re-affirm a stale claim. Refuses without a fresh refutation.")]
mutants-reaffirm crate key refutations:
    #!/usr/bin/env bash
    set -euo pipefail
    just mutants-census "$1"
    {{ mt_bin }} ledger reaffirm \
        --key "$2" --refutation "$3" \
        --census "target/mutation-triage/census-$1.json"

# Revoke a wrong claim IN PLACE. The tombstone stays forever so nobody
# re-adjudicates the same lie.
[doc("Revoke a wrong claim in place. The tombstone stays forever.")]
mutants-revoke key issue why:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ mt_bin }} ledger revoke \
        --key "$1" --bead "$2" --why "$3" \
        --at "$(git rev-parse --short HEAD)"

# Print the exact single-mutant re-run for one key, and assert it selects
# something. A name regex matching nothing exits successfully with zero mutants
# tested, which reads as "everything killed".
[doc("Print the single-mutant re-run for one key, and assert it selects something.")]
mutants-kill crate key:
    #!/usr/bin/env bash
    set -euo pipefail
    just mutants-census "$1"
    fingerprint="$("{{ mt_scripts }}/tree-fingerprint.sh")"
    flags=()
    if [ -f "target/mutation-triage/green-$fingerprint" ]; then flags+=(--green-tree); fi
    {{ mt_bin }} kill --key "$2" \
        --census "target/mutation-triage/census-$1.json" "${flags[@]}"

# Draft the test-gap issue for one key: what BEHAVIOUR is untested, plus the
# re-run that is the only thing allowed to close it.
[doc("Draft the test-gap issue for one key.")]
mutants-bead-draft crate key:
    #!/usr/bin/env bash
    set -euo pipefail
    just mutants-census "$1"
    {{ mt_bin }} bead-draft --key "$2" \
        --census "target/mutation-triage/census-$1.json"
